<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow the app to capture screen content (required for ScreenCaptureKit) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Network client access for Gemini Live WebSocket -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Microphone access for user audio capture -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    
    <!-- Audio output for playback -->
    <key>com.apple.security.device.audio-output</key>
    <true/>
    
    <!-- Keychain access for secure credential storage -->
    <key>com.apple.security.keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.traductor.desktop</string>
    </array>
    
    <!-- Hardened runtime exceptions -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
